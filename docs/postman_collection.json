        ],
        "url": {
          "raw": "{{baseUrl}}/api/cases?page=1&per_page=10&status=All&search=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "cases"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "per_page", "value": "10" },
            { "key": "status", "value": "All" },
            { "key": "search", "value": "" }
          ]
        }
      }
    },
